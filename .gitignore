# Sprint21 fusion runs: the evidence a reviewer needs is the REPORT.md, the CSVs and the
# run_manifest.json at each run root. The nested per-image colour-runner output and the
# injection working directories are large, reproducible byproducts -- keep them local.
runs/**/grvi/
runs/**/transfer/d*/

# Sprint22: the ONE committed .h264 — a synthetic ffmpeg test pattern
# (golden wire-contract vector). Every other .h264 stays ignored.
!tests/vectors/bm_media_h264/payload.h264

# Sprint25: Spotter SD card copies live next to the reports; never commit card contents
runs/sprint25_sd_*/SPOT-*/
runs/sprint25_indoor15_*/SPOT-*/
runs/sprint25_indoor15_*/console_as_sd/
runs/sprint25_outdoor_*/SPOT-*/
runs/sprint25_pacing13_*/SPOT-*/

