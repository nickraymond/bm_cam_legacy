# hil.env.example — copy to hil/hil.env (gitignored) and `source hil/hil.env` before the tools.
# Hosts and ids only. NO tokens here: the staging admin token stays on the monitor host
# (~/.config/nereus/heal_driver.env) and is read there by the tools that run on it.

# Spotter console monitor (nereus000; LAN IP because nereus000.local sometimes fails to resolve)
export HIL_MONITOR="pi@192.168.1.45"
export HIL_MONITOR_LOG_ROOT="/home/pi/spotter_logs"
export HIL_MONITOR_ENV_FILE="/home/pi/.config/nereus/heal_driver.env"

# Rigs: SPOT-ID=DEVICE_ID=HOST=BRIDGE (bench release units, R1)
export HIL_RIG_A="SPOT-33507C=BMCAM_003=bmcam003=c3c564b91856226c"
export HIL_RIG_B="SPOT-31593C=BMCAM_004=bmcam004=0e582dd12c1e1480"

# Unit paths
export HIL_UNIT_USER="pi"
export HIL_UNIT_APP="/home/pi/BM_Devel_Pi"
export HIL_UNIT_REPO="/home/pi/repos/bm_cam_legacy"

# Staging API base (used on the monitor host only)
export HIL_API="https://nereus-vision-staging.onrender.com"

# Run folder root (repo-relative)
export HIL_RUNS="runs"
